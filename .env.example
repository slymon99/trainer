# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- intervals.icu -----------------------------------------------------
# API key: https://intervals.icu/settings → "Developer Settings"
INTERVALS_API_KEY=
# Your athlete id, e.g. i123456 (shown in the URL when logged in).
# "0" also works and means "the current athlete".
INTERVALS_ATHLETE_ID=0

# --- Strava ------------------------------------------------------------
# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to exactly: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Hevy (strength log) -----------------------------------------------
# API key: https://hevy.com/settings?developer — requires Hevy Pro.
HEVY_API_KEY=
