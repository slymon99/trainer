# --- secrets -----------------------------------------------------------
.env
.strava_tokens.json

# --- local data --------------------------------------------------------
# Not secret (the repo is private) — just regenerable and bulky. data/ is
# rebuilt by `pixi run sync`, and __marimo__/ is a cache of notebook cell
# outputs that churns on every run.
#
# plan.md is deliberately NOT here — it's the athlete's brief and its history
# is worth tracking. It holds weight, HR and HRV, which is fine while this repo
# is private. If it is ever made public, untrack plan.md first, and note that
# rewriting history is the only way to remove it from past commits.
data/
*.private.md
__marimo__/

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --- pixi --------------------------------------------------------------
.pixi/*
!.pixi/config.toml

# --- macos -------------------------------------------------------------
.DS_Store

# local one-off block-push scripts (contain personal targets)
scripts/
