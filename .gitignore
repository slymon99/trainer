# --- secrets -----------------------------------------------------------
.env
.strava_tokens.json

# --- local data --------------------------------------------------------
# Not secret (the repo is private) — just regenerable and bulky. data/ is
# rebuilt by `pixi run sync`, and __marimo__/ is a cache of notebook cell
# outputs that churns on every run.
#
# Keep athlete-specific, long-term prescriptions out of the repository. One-off
# calendar payloads belong in ignored scripts; reusable workout syntax stays in docs/.
plan.md
plan/
training-plan.md
data/
*.private.md
__marimo__/

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --- pixi --------------------------------------------------------------
.pixi/*
!.pixi/config.toml

# --- macos -------------------------------------------------------------
.DS_Store

# local one-off block-push scripts (contain personal targets)
scripts/
